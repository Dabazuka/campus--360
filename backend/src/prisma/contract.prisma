// use prisma-next

enum Role {
  STUDENT
  TEACHER
}

enum EventType {
  THEORY_EXAM
  PRACTICAL
  VIVA
  ASSIGNMENT
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model User {
  id           Int      @id @default(autoincrement())
  loginId      String   @unique
  passwordHash String
  role         Role
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  student      Student?
  notices      Notice[]
  events       Event[]
  replies      Reply[]
}

model Student {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  studentId            String   @unique
  name                 String
  section              String
  classMarks           Int
  yearlyCgpa           Float
  assignmentSubmitted  Boolean  @default(false)
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  user                User              @relation(fields: [userId], references: [id])
  subjects            StudentSubject[]
  doubts              Doubt[]
  complaints          Complaint[]
}

model Subject {
  id       Int              @id @default(autoincrement())
  name     String           @unique

  students StudentSubject[]
  doubts   Doubt[]
}

model StudentSubject {
  id              Int      @id @default(autoincrement())
  studentId       Int
  subjectId       Int
  classesAttended Int
  classesTotal    Int
  grade           String

  student         Student  @relation(fields: [studentId], references: [id])
  subject         Subject  @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  date        String
  time        String
  type        EventType
  createdBy   Int
  createdAt   TimestamptzString @default(now())

  creator     User      @relation(fields: [createdBy], references: [id])
}

model Notice {
  id          Int      @id @default(autoincrement())
  authorId    Int
  category    String
  title       String
  description String
  urgent      Boolean  @default(false)
  createdAt   TimestamptzString @default(now())

  author      User     @relation(fields: [authorId], references: [id])
}

model Doubt {
  id        Int      @id @default(autoincrement())
  studentId Int
  subjectId Int
  question  String
  solved    Boolean  @default(false)
  createdAt TimestamptzString @default(now())

  student   Student  @relation(fields: [studentId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  replies   Reply[]
}

model Reply {
  id        Int      @id @default(autoincrement())
  doubtId   Int
  authorId  Int
  message   String
  createdAt TimestamptzString @default(now())

  doubt     Doubt    @relation(fields: [doubtId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model Complaint {
  id          Int             @id @default(autoincrement())
  studentId   Int
  section     String
  category    String
  title       String
  description String
  status      ComplaintStatus @default(PENDING)
  adminNote   String?
  createdAt   TimestamptzString @default(now())
  resolvedAt  TimestamptzString?

  student     Student         @relation(fields: [studentId], references: [id])
}